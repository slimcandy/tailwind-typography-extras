{
  "name": "tailwind-typography-extras",
  "private": true,
  "description": "Four tiny Tailwind CSS v4 packages for hanging punctuation, small caps, drop caps and text rendering, with the demo page.",
  "keywords": [
    "tailwindcss",
    "tailwind-v4",
    "typography",
    "hanging-punctuation",
    "small-caps",
    "drop-cap",
    "initial-letter",
    "text-rendering"
  ],
  "homepage": "https://type.avolkov.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimcandy/tailwind-typography-extras.git"
  },
  "bugs": {
    "url": "https://github.com/slimcandy/tailwind-typography-extras/issues"
  },
  "author": "Aleksei Volkov",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "dev": "tailwindcss -i site/input.css -o site/style.css --watch",
    "prebuild": "sh scripts/fetch-fonts.sh",
    "build": "tailwindcss -i site/input.css -o site/style.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/node": "4.3.3",
    "tailwind-font-variant-caps": "file:packages/tailwind-font-variant-caps",
    "tailwind-hanging-punctuation": "file:packages/tailwind-hanging-punctuation",
    "tailwind-initial-letter": "file:packages/tailwind-initial-letter",
    "tailwindcss": "4.3.3",
    "tailwindcss-text-rendering": "file:packages/tailwindcss-text-rendering"
  }
}
